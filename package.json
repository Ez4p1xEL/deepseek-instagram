{
  "name": "deepseek-instagram",
  "version": "0.1.0",
  "description": "DSH 插件：把 Instagram 变成你的 AI 助理 —— 自动发 Story / Note，分享 DSH 使用日常",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "vendor/instagram-mcp/ig_cli.py",
    "vendor/instagram-mcp/render_card.py"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "probe": "node scripts/probe_shape.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "instagram",
    "assistant",
    "story",
    "note"
  ],
  "license": "MIT",
  "author": "p1xEL_mc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p1xEL_mc/deepseek-instagram.git"
  },
  "homepage": "https://github.com/p1xEL_mc/deepseek-instagram#readme",
  "bugs": {
    "url": "https://github.com/p1xEL_mc/deepseek-instagram/issues"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
